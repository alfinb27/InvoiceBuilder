<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (ADR-0013): the database and safety snapshots go to Google Drive; caches (PDFs, fonts) do not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="snapshots/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="snapshots/" />
    </device-transfer>
</data-extraction-rules>

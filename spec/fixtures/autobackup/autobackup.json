    },
    {
      "id": "autobackup-prune-tie-larger-id-is-newer",
      "description": "Equal createdAt: the larger id counts as newer, so with keep 2 the smallest id goes.",
      "input": {
        "op": "filesToDelete",
        "deviceId": "dev-me",
        "keep": 2,
        "entries": [
          {
            "id": "b",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791600000000
          },
          {
            "id": "a",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791600000000
          },
          {
            "id": "c",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791600000000
          }
        ]
      },
      "expected": {
        "delete": [
          "a"
        ]
      }
    },
    {
      "id": "autobackup-prune-ignores-untagged-files",
      "description": "A file without the app's properties is never deleted.",
      "input": {
        "op": "filesToDelete",
        "deviceId": "dev-me",
        "keep": 1,
        "entries": [
          {
            "id": "own-old",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791513600000
          },
          {
            "id": "untagged",
            "name": "InvoiceBackup-2026-10-10.invoicebackup"
          },
          {
            "id": "own-new",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791600000000
          }
        ]
      },
      "expected": {
        "delete": [
          "own-old"
        ]
      }
    },
    {
      "id": "autobackup-list-newest-first",
      "description": "The restore list: tagged files newest first, ties by larger id, untagged files left out.",
      "input": {
        "op": "newestFirst",
        "entries": [
          {
            "id": "p",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-other",
            "createdAt": 1791513600000
          },
          {
            "id": "q",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791600000000
          },
          {
            "id": "untagged",
            "name": "InvoiceBackup-2026-10-10.invoicebackup"
          },
          {
            "id": "r",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791513600000
          },
          {
            "id": "s",
            "name": "InvoiceBackup-2026-10-10.invoicebackup",
            "deviceId": "dev-me",
            "createdAt": 1791427200000
          }
        ]
      },
      "expected": {
        "ids": [

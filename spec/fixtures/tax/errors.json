{
  "$schema": "../../schema/fixtures.schema.json",
  "kind": "tax",
  "description": "Inputs the engine must reject (ENGINE.md §3, Errors vs issues): no ComputedDocument, only the error code and, when it concerns one line, its index.",
  "cases": [
    {
      "id": "error-no-component-rule",
      "reviewed": false,
      "explain": "A supply type the generic config has no rule for: computation stops with no_component_rule. Expected: error no_component_rule.",
      "config": "GENERIC@2026-09-19",
      "input": {
        "seller": {
          "registration": "registered",
          "country": "US",
          "homeCurrency": "USD",
          "address": "200 Main St, Springfield",
          "customRates": [
            {
              "id": "sales",
              "category": "standard",
              "label": "Sales tax 8.875%",
              "effectiveFrom": "2020-01-01",
              "components": [
                {
                  "code": "SALES",
                  "label": "Sales tax",
                  "percent": "8.875"
                }
              ]
            },
            {
              "id": "tenpct",
              "category": "standard",
              "label": "Tax 10%",
              "effectiveFrom": "2020-01-01",
              "components": [
                {
                  "code": "TAX",
                  "label": "Tax",
                  "percent": "10"
                }
              ]
            },
            {
              "id": "compound",
              "category": "standard",
              "label": "5% + 10% compound",
              "effectiveFrom": "2020-01-01",
              "components": [
                {
                  "code": "A",
                  "label": "Tax A",
                  "percent": "5"
                },
                {
                  "code": "B",
                  "label": "Tax B",
                  "percent": "10",
                  "compound": true
                }
              ]
            }
          ]
        },
        "buyer": {
          "name": "Acme Inc.",
          "address": "1 Market St, San Francisco, CA 94105",
          "country": "US",
          "isBusiness": true
        },
        "draft": {
          "docType": "invoice",
          "issueDate": "2026-09-19",
          "currency": "USD",
          "supplyType": "exportWithTax",
          "lines": [
            {
              "description": "Consulting",
              "quantity": "1",
              "unitPrice": 10000,
              "rateId": "sales"
            }
          ]
        }
      },
      "expected": {
        "error": "no_component_rule"
      }
    },

{
  "$schema": "../../schema/fixtures.schema.json",
  "kind": "reminder",
  "description": "ReminderScheduler.plan: eligibility, override precedence, dates before `from` dropped, cap truncation (reminders.md §3).",
  "cases": [
    {
      "id": "reminder-business-default",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-1", "remindOn": "2026-09-08" }
        ]
      }
    },
    {
      "id": "reminder-override-beats-default",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "overrideDays": 2, "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-1", "remindOn": "2026-09-03" }
        ]
      }
    },
    {
      "id": "reminder-both-null-not-scheduled",
      "input": {
        "businessDefaultDays": null,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": []
      }
    },
    {
      "id": "reminder-no-due-date-not-scheduled",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "status": "issued" }
        ]
      },
      "expected": {
        "scheduled": []
      }
    },
    {
      "id": "reminder-paid-excluded",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "paid" }
        ]
      },
      "expected": {
        "scheduled": []
      }
    },
    {
      "id": "reminder-draft-excluded",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "draft" }
        ]
      },
      "expected": {
        "scheduled": []
      }
    },
    {
      "id": "reminder-void-excluded",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "void" }
        ]
      },
      "expected": {
        "scheduled": []
      }
    },
    {
      "id": "reminder-sorted-by-remind-on",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-late", "dueDate": "2026-09-10", "status": "overdue" },
          { "documentId": "doc-early", "dueDate": "2026-09-01", "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-early", "remindOn": "2026-09-08" },
          { "documentId": "doc-late", "remindOn": "2026-09-17" }
        ]
      }
    },
    {
      "id": "reminder-cap-truncates-to-nearest",
      "input": {
        "businessDefaultDays": 0,
        "cap": 2,
        "from": "2026-09-01",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "overdue" },
          { "documentId": "doc-2", "dueDate": "2026-09-02", "status": "overdue" },
          { "documentId": "doc-3", "dueDate": "2026-09-03", "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-1", "remindOn": "2026-09-01" },
          { "documentId": "doc-2", "remindOn": "2026-09-02" }
        ]
      }
    },
    {
      "id": "reminder-before-from-dropped",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-10",
        "candidates": [
          { "documentId": "doc-old", "dueDate": "2026-09-01", "status": "overdue" },
          { "documentId": "doc-new", "dueDate": "2026-09-05", "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-new", "remindOn": "2026-09-12" }
        ]
      }
    },
    {
      "id": "reminder-on-from-kept",
      "input": {
        "businessDefaultDays": 7,
        "cap": 50,
        "from": "2026-09-08",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "overdue" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-1", "remindOn": "2026-09-08" }
        ]
      }
    },
    {
      "id": "reminder-past-dates-do-not-use-the-cap",
      "input": {
        "businessDefaultDays": 0,
        "cap": 2,
        "from": "2026-09-03",
        "candidates": [
          { "documentId": "doc-1", "dueDate": "2026-09-01", "status": "overdue" },
          { "documentId": "doc-2", "dueDate": "2026-09-02", "status": "overdue" },
          { "documentId": "doc-3", "dueDate": "2026-09-03", "status": "overdue" },
          { "documentId": "doc-4", "dueDate": "2026-09-04", "status": "issued" },
          { "documentId": "doc-5", "dueDate": "2026-09-05", "status": "issued" }
        ]
      },
      "expected": {
        "scheduled": [
          { "documentId": "doc-3", "remindOn": "2026-09-03" },
          { "documentId": "doc-4", "remindOn": "2026-09-04" }
        ]
      }
    }
  ]

{
  "$schema": "../schema/tax-config.schema.json",
  "schemaVersion": 1,
  "country": "IN",
  "configVersion": "2025-09-22",
  "reviewStatus": "draft",
  "currency": "INR",
  "paperSize": "A4",
  "fiscalYearStart": "04-01",
  "amountInWords": true,
  "labels": {
    "taxName": "GST",
    "taxIdName": "GSTIN",
    "productCodeName": "HSN/SAC",
    "regionName": "State",
    "placeOfSupply": "Place of supply"
  },
  "taxIdFormats": [
    {
      "id": "gstin",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
      "checksum": "gstinMod36",
      "regionFromPrefix": 2
    }
  ],
  "regions": [
    { "code": "01", "name": "Jammu and Kashmir", "localComponent": "SGST" },
    { "code": "02", "name": "Himachal Pradesh", "localComponent": "SGST" },
    { "code": "03", "name": "Punjab", "localComponent": "SGST" },
    { "code": "04", "name": "Chandigarh", "localComponent": "UTGST" },
    { "code": "05", "name": "Uttarakhand", "localComponent": "SGST" },
    { "code": "06", "name": "Haryana", "localComponent": "SGST" },
    { "code": "07", "name": "Delhi", "localComponent": "SGST" },
    { "code": "08", "name": "Rajasthan", "localComponent": "SGST" },
    { "code": "09", "name": "Uttar Pradesh", "localComponent": "SGST" },
    { "code": "10", "name": "Bihar", "localComponent": "SGST" },
    { "code": "11", "name": "Sikkim", "localComponent": "SGST" },
    { "code": "12", "name": "Arunachal Pradesh", "localComponent": "SGST" },
    { "code": "13", "name": "Nagaland", "localComponent": "SGST" },
    { "code": "14", "name": "Manipur", "localComponent": "SGST" },
    { "code": "15", "name": "Mizoram", "localComponent": "SGST" },
    { "code": "16", "name": "Tripura", "localComponent": "SGST" },
    { "code": "17", "name": "Meghalaya", "localComponent": "SGST" },
    { "code": "18", "name": "Assam", "localComponent": "SGST" },
    { "code": "19", "name": "West Bengal", "localComponent": "SGST" },
    { "code": "20", "name": "Jharkhand", "localComponent": "SGST" },
    { "code": "21", "name": "Odisha", "localComponent": "SGST" },
    { "code": "22", "name": "Chhattisgarh", "localComponent": "SGST" },
    { "code": "23", "name": "Madhya Pradesh", "localComponent": "SGST" },
    { "code": "24", "name": "Gujarat", "localComponent": "SGST" },
    { "code": "25", "name": "Daman and Diu (merged into 26)", "localComponent": "UTGST", "active": false },
    { "code": "26", "name": "Dadra and Nagar Haveli and Daman and Diu", "localComponent": "UTGST" },
    { "code": "27", "name": "Maharashtra", "localComponent": "SGST" },
    { "code": "28", "name": "Andhra Pradesh (before 2014)", "localComponent": "SGST", "active": false },
    { "code": "29", "name": "Karnataka", "localComponent": "SGST" },
    { "code": "30", "name": "Goa", "localComponent": "SGST" },
    { "code": "31", "name": "Lakshadweep", "localComponent": "UTGST" },
    { "code": "32", "name": "Kerala", "localComponent": "SGST" },
    { "code": "33", "name": "Tamil Nadu", "localComponent": "SGST" },
    { "code": "34", "name": "Puducherry", "localComponent": "SGST" },
    { "code": "35", "name": "Andaman and Nicobar Islands", "localComponent": "UTGST" },
    { "code": "36", "name": "Telangana", "localComponent": "SGST" },
    { "code": "37", "name": "Andhra Pradesh", "localComponent": "SGST" },
    { "code": "38", "name": "Ladakh", "localComponent": "UTGST" },
    { "code": "97", "name": "Other Territory", "localComponent": "UTGST" }
  ],
  "foreignRegion": "96",
  "registrations": [
    {
      "id": "regular",
      "label": "Registered (regular)",
      "chargesTax": true,
      "requiresTaxId": true,
      "titles": { "invoice": "Tax Invoice", "invoiceAllExempt": "Bill of Supply", "quote": "Quotation" }
    },
    {
      "id": "composition",
      "label": "Composition scheme",
      "chargesTax": false,
      "requiresTaxId": true,
      "titles": { "invoice": "Bill of Supply", "quote": "Quotation" },
      "notes": ["composition_declaration"]
    },
    {
      "id": "unregistered",
      "label": "Not registered for GST",
      "chargesTax": false,
      "requiresTaxId": false,
      "titles": { "invoice": "Invoice", "quote": "Quotation" }
    }
  ],
  "rates": [
    { "id": "gst_0", "percent": "0", "category": "standard", "label": "GST 0%", "effectiveFrom": "2017-07-01" },
    { "id": "gst_0_1", "percent": "0.1", "category": "standard", "label": "GST 0.1%", "effectiveFrom": "2017-10-23" },
    { "id": "gst_0_25", "percent": "0.25", "category": "standard", "label": "GST 0.25%", "effectiveFrom": "2017-07-01" },
    { "id": "gst_1_5", "percent": "1.5", "category": "standard", "label": "GST 1.5%", "effectiveFrom": "2017-07-01" },
    { "id": "gst_3", "percent": "3", "category": "standard", "label": "GST 3%", "effectiveFrom": "2017-07-01" },
    { "id": "gst_5", "percent": "5", "category": "standard", "label": "GST 5%", "effectiveFrom": "2017-07-01" },
    { "id": "gst_12", "percent": "12", "category": "standard", "label": "GST 12%", "effectiveFrom": "2017-07-01", "effectiveTo": "2025-09-21" },
    { "id": "gst_18", "percent": "18", "category": "standard", "label": "GST 18%", "effectiveFrom": "2017-07-01" },
    { "id": "gst_28", "percent": "28", "category": "standard", "label": "GST 28%", "effectiveFrom": "2017-07-01", "note": "After 2025-09-22 retained only for goods still under compensation cess; verify before use." },
    { "id": "gst_40", "percent": "40", "category": "standard", "label": "GST 40%", "effectiveFrom": "2025-09-22" },
    { "id": "exempt", "percent": "0", "category": "exempt", "label": "Exempt", "effectiveFrom": "2017-07-01" },
    { "id": "nil", "percent": "0", "category": "nil", "label": "Nil rated", "effectiveFrom": "2017-07-01" }
  ],
  "supplyTypes": [
    { "id": "domestic", "label": "Within India" },
    { "id": "exportWithoutTax", "label": "Export under LUT or bond (no IGST)" },
    { "id": "exportWithTax", "label": "Export with IGST paid" }
  ],
  "supplyTypeDefaults": [
    { "when": { "buyerForeign": true, "sellerHasLutReference": true }, "supplyType": "exportWithoutTax" },
    { "when": { "buyerForeign": true }, "supplyType": "exportWithTax" }
  ],
  "componentRules": [
    {
      "when": { "supplyType": ["domestic"], "sameRegion": true },
      "components": [
        { "code": "CGST", "share": "0.5" },
        { "code": "$localComponent", "share": "0.5" }
      ]
    },
    {
      "when": { "supplyType": ["domestic"], "sameRegion": false },
      "components": [{ "code": "IGST", "share": "1" }]
    },
    {
      "when": { "supplyType": ["exportWithoutTax"] },
      "components": [{ "code": "IGST", "share": "1", "rateOverride": "0", "categoryOverride": "zero" }],
      "notes": ["export_lut"]
    },
    {
      "when": { "supplyType": ["exportWithTax"] },
      "components": [{ "code": "IGST", "share": "1" }],
      "notes": ["export_igst"]
    }
  ],
  "reverseCharge": { "supported": true, "notes": ["rcm"] },
  "rounding": {
    "amountMode": "halfAwayFromZero",
    "taxLevel": "line",
    "taxMode": "halfAwayFromZero",
    "grandTotal": { "roundToMinor": 100, "mode": "halfAwayFromZero", "label": "Round off", "defaultOn": true }
  },
  "shipping": { "rule": "principalSupplyRate" },
  "productCodes": {
    "tiers": [
      { "maxTurnoverMinor": 5000000000, "b2bDigits": 4, "b2cDigits": 0 },
      { "b2bDigits": 6, "b2cDigits": 6 }
    ]
  },
  "numbering": {
    "maxLength": 16,
    "allowedPattern": "^[A-Za-z0-9/-]+$",
    "reset": "fiscalYear",
    "invoicePattern": "INV/{fy}/{seq:4}",
    "quotePattern": "QT/{fy}/{seq:4}"
  },
  "foreignCurrency": { "homeTotals": true, "taxInHomeCurrency": false },
  "checks": [
    { "code": "seller_tax_id_missing", "severity": "error", "require": ["seller.taxId"], "when": { "sellerRegistration": ["regular", "composition"] } },
    { "code": "buyer_details_required", "severity": "warning", "require": ["buyer.name", "buyer.address", "buyer.region"], "when": { "supplyType": ["domestic"], "buyerHasTaxId": false, "totalAtLeastMinor": 5000000 } },
    { "code": "buyer_address_missing", "severity": "warning", "require": ["buyer.name", "buyer.address"], "when": { "buyerHasTaxId": true } },
    { "code": "lut_reference_missing", "severity": "error", "require": ["seller.lutReference"], "when": { "sellerRegistration": ["regular"], "supplyType": ["exportWithoutTax"] } },
    { "code": "export_buyer_details_required", "severity": "warning", "require": ["buyer.name", "buyer.address", "buyer.country"], "when": { "supplyType": ["exportWithoutTax", "exportWithTax"] } },
    { "code": "product_code_missing", "severity": "warning", "type": "productCodeDigits", "when": { "sellerRegistration": ["regular", "composition"] } }
  ],
  "notesCatalog": {
    "composition_declaration": { "text": "Composition taxable person, not eligible to collect tax on supplies", "placement": "top" },
    "export_lut": { "text": "SUPPLY MEANT FOR EXPORT UNDER BOND OR LETTER OF UNDERTAKING WITHOUT PAYMENT OF INTEGRATED TAX", "placement": "bottom" },
    "export_igst": { "text": "SUPPLY MEANT FOR EXPORT ON PAYMENT OF INTEGRATED TAX", "placement": "bottom" },
    "rcm": { "text": "Whether tax is payable on reverse charge basis: Yes", "placement": "bottom" }
  }
}

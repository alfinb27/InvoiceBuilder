{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoicebuilder.local/spec/schema/design-tokens.schema.json",
  "title": "Design tokens (spec/design/tokens.json)",
  "type": "object",
  "required": [
    "version",
    "color",
    "status",
    "fonts",
    "type",
    "space",
    "radius",
    "layout",
    "pdf"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "color": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "$ref": "#/$defs/palette"
        },
        "dark": {
          "$ref": "#/$defs/palette"
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "fonts": {
      "type": "object",
      "required": [
        "display",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "$comment": {
          "type": "string"
        },
        "display": {
          "$ref": "#/$defs/fontFamily"
        },
        "text": {
          "$ref": "#/$defs/fontFamily"
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "font",
          "size",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "font": {
            "enum": [
              "display",
              "text"
            ]
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "weight": {
            "enum": [
              "regular",
              "medium",
              "semibold",
              "bold"
            ]
          },
          "monospacedDigits": {
            "type": "boolean"
          },
          "tracking": {
            "type": "number"
          },
          "uppercase": {
            "type": "boolean"
          }
        }
      }
    },
    "space": {
      "$ref": "#/$defs/numbers"
    },
    "radius": {
      "$ref": "#/$defs/numbers"
    },
    "layout": {
      "$ref": "#/$defs/numbers"
    },
    "pdf": {
      "type": "object",
      "required": [
        "accentPresets",
        "fontFamily",
        "fallbackFonts",
        "paper"
      ],
      "additionalProperties": false,
      "properties": {
        "$comment": {
          "type": "string"
        },
        "accentPresets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hex"
          }
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "fallbackFonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paper": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "width",
              "height",
              "margin"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "margin": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "palette": {
      "type": "object",
      "required": [
        "brand",
        "brandPressed",
        "brandOn",
        "brandTint",
        "background",
        "surface",
        "surfaceMuted",
        "surfaceSubtle",
        "border",
        "borderStrong",
        "control",
        "textPrimary",
        "textSecondary",
        "textTertiary",
        "tip",
        "tipOn",
        "tipIcon",
        "highlight",
        "scrim",
        "success",
        "warning",
        "danger",
        "info"
      ],
      "additionalProperties": false,
      "properties": {
        "brand": {
          "$ref": "#/$defs/hex"
        },
        "brandPressed": {
          "$ref": "#/$defs/hex"
        },
        "brandOn": {
          "$ref": "#/$defs/hex"
        },
        "brandTint": {
          "$ref": "#/$defs/hex"
        },
        "background": {
          "$ref": "#/$defs/hex"
        },
        "surface": {
          "$ref": "#/$defs/hex"
        },
        "surfaceMuted": {
          "$ref": "#/$defs/hex"
        },
        "surfaceSubtle": {
          "$ref": "#/$defs/hex"
        },
        "border": {
          "$ref": "#/$defs/hex"
        },
        "borderStrong": {
          "$ref": "#/$defs/hex"
        },
        "control": {
          "$ref": "#/$defs/hex"
        },
        "textPrimary": {
          "$ref": "#/$defs/hex"
        },
        "textSecondary": {
          "$ref": "#/$defs/hex"
        },
        "textTertiary": {
          "$ref": "#/$defs/hex"
        },
        "tip": {
          "$ref": "#/$defs/hex"
        },
        "tipOn": {
          "$ref": "#/$defs/hex"
        },
        "tipIcon": {
          "$ref": "#/$defs/hex"
        },
        "highlight": {
          "$ref": "#/$defs/hex"
        },
        "scrim": {
          "$ref": "#/$defs/hex"
        },
        "success": {
          "$ref": "#/$defs/hex"
        },
        "warning": {
          "$ref": "#/$defs/hex"
        },
        "danger": {
          "$ref": "#/$defs/hex"
        },
        "info": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "numbers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "fontFamily": {
      "type": "object",
      "required": [
        "family",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "regular",
              "medium",
              "semibold",
              "bold"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          }
        }
      }
    }
  }
}

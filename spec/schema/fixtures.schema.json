{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoicebuilder.local/spec/schema/fixtures.schema.json",
  "title": "Golden fixture file",
  "description": "A group of test cases of one kind. Both platforms load every file under spec/fixtures and assert that the actual output contains every key/value in `expected` (extra keys in actual output are allowed; arrays compare element by element, in order).",
  "type": "object",
  "required": ["kind", "description", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "enum": ["tax", "numbering", "validation", "words", "format", "status", "rounding", "distribute", "upi", "field", "input", "document", "pdf", "reminder", "backup", "series", "billing"] },
    "description": { "type": "string" },
    "cases": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "tax" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/taxCase" } } } } },
    { "if": { "properties": { "kind": { "const": "numbering" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/numberingCase" } } } } },
    { "if": { "properties": { "kind": { "const": "validation" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/validationCase" } } } } },
    { "if": { "properties": { "kind": { "const": "words" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/wordsCase" } } } } },
    { "if": { "properties": { "kind": { "const": "format" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/formatCase" } } } } },
    { "if": { "properties": { "kind": { "const": "status" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/statusCase" } } } } },
    { "if": { "properties": { "kind": { "const": "rounding" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/roundingCase" } } } } },
    { "if": { "properties": { "kind": { "const": "distribute" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/distributeCase" } } } } },
    { "if": { "properties": { "kind": { "const": "upi" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/upiCase" } } } } },
    { "if": { "properties": { "kind": { "const": "field" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/fieldCase" } } } } },
    { "if": { "properties": { "kind": { "const": "input" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/inputCase" } } } } },
    { "if": { "properties": { "kind": { "const": "document" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/documentCase" } } } } },
    { "if": { "properties": { "kind": { "const": "pdf" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/pdfCase" } } } } },
    { "if": { "properties": { "kind": { "const": "reminder" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/reminderCase" } } } } },
    { "if": { "properties": { "kind": { "const": "backup" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/backupCase" } } } } },
    { "if": { "properties": { "kind": { "const": "series" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/seriesCase" } } } } },
    { "if": { "properties": { "kind": { "const": "billing" } } }, "then": { "properties": { "cases": { "type": "array", "items": { "$ref": "#/$defs/billingCase" } } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decimal": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
    "minor": { "type": "integer" },
    "discount": {
      "oneOf": [
        { "type": "object", "required": ["type", "value"], "additionalProperties": false,
          "properties": { "type": { "const": "percent" }, "value": { "$ref": "#/$defs/decimal" } } },
        { "type": "object", "required": ["type", "value"], "additionalProperties": false,
          "properties": { "type": { "const": "amount" }, "value": { "$ref": "#/$defs/minor" } } }
      ]
    },
    "taxCase": {
      "type": "object",
      "required": ["id", "reviewed", "explain", "config", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reviewed": { "type": "boolean" },
        "explain": { "type": "string" },
        "config": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*@[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "<tax config id>@<configVersion>; must name a file in spec/tax (checked by validate.mjs)." },
        "input": {
          "type": "object",
          "required": ["seller", "buyer", "draft"],
          "additionalProperties": false,
          "properties": {
            "seller": {
              "type": "object",
              "required": ["registration", "country", "homeCurrency"],
              "additionalProperties": false,
              "properties": {
                "registration": { "type": "string" }, "taxId": { "type": "string" }, "region": { "type": "string" },
                "country": { "type": "string" }, "homeCurrency": { "type": "string" }, "lutReference": { "type": "string" },
                "address": { "type": "string" }, "turnoverMinor": { "$ref": "#/$defs/minor" },
                "customRates": { "type": "array" }
              }
            },
            "buyer": {
              "type": "object",
              "required": ["isBusiness"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" }, "address": { "type": "string" }, "country": { "type": "string" },
                "region": { "type": "string" }, "taxId": { "type": "string" }, "isBusiness": { "type": "boolean" }
              }
            },
            "draft": {
              "type": "object",
              "required": ["docType", "issueDate", "currency", "supplyType", "lines"],
              "additionalProperties": false,
              "properties": {
                "docType": { "enum": ["invoice", "quote"] },
                "issueDate": { "$ref": "#/$defs/date" }, "supplyDate": { "$ref": "#/$defs/date" },
                "dueDate": { "$ref": "#/$defs/date" },
                "currency": { "type": "string" }, "exchangeRate": { "$ref": "#/$defs/decimal" },
                "supplyType": { "type": "string" }, "placeOfSupply": { "type": "string" },
                "reverseCharge": { "type": "boolean" }, "pricesIncludeTax": { "type": "boolean" },
                "discount": { "$ref": "#/$defs/discount" }, "shipping": { "$ref": "#/$defs/minor" },
                "roundOff": { "type": "boolean" },
                "lines": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["quantity", "unitPrice", "rateId"],
                    "additionalProperties": false,
                    "properties": {
                      "description": { "type": "string" }, "productCode": { "type": "string" },
                      "quantity": { "$ref": "#/$defs/decimal" }, "unitPrice": { "$ref": "#/$defs/minor" },
                      "discount": { "$ref": "#/$defs/discount" }, "rateId": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "expected": {
          "description": "Either the ComputedDocument keys to compare, or an engine error (ENGINE.md §3, Errors vs issues).",
          "oneOf": [
            { "type": "object", "required": ["title", "lines", "taxLines", "totals"], "additionalProperties": false,
              "properties": {
                "title": { "type": "string" }, "inclusive": { "type": "boolean" }, "reverseCharge": { "type": "boolean" },
                "placeOfSupply": { "type": "string" }, "sameRegion": { "type": "boolean" },
                "lines": { "type": "array" }, "shipping": { "type": "object" }, "taxLines": { "type": "array" },
                "totals": { "type": "object" }, "home": { "type": ["object", "null"] },
                "notes": { "type": "array" }, "issues": { "type": "array" }
              } },
            { "type": "object", "required": ["error"], "additionalProperties": false,
              "properties": {
                "error": { "enum": ["no_component_rule", "unknown_rate", "unknown_region", "discount_exceeds_subtotal",
                                    "line_discount_exceeds_amount", "inclusive_compound_unsupported", "invalid_input"] },
                "line": { "type": "integer", "minimum": 0 }
              } }
          ]
        }
      }
    },
    "pdfCase": {
      "description": "A stored document rendered into the PDF view model (spec/pdf/RENDERING.md §1).",
      "type": "object", "required": ["id", "explain", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "explain": { "type": "string" },
        "input": {
          "type": "object", "required": ["template", "document"], "additionalProperties": false,
          "properties": {
            "template": { "enum": ["classic", "modern", "minimal", "compact"] },
            "document": { "$ref": "domain.schema.json#/$defs/Document" }
          }
        },
        "expected": {
          "type": "object",
          "required": ["title", "isDraft", "numberLabel", "meta", "seller", "columns", "rows", "totals", "notes",
                       "payment", "signature", "footer"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "isDraft": { "type": "boolean" },
            "draftLabel": { "type": ["string", "null"] },
            "number": { "type": ["string", "null"] },
            "numberLabel": { "type": "string" },
            "meta": { "type": "array" },
            "seller": { "type": "object" },
            "buyer": { "type": "object" },
            "shipTo": { "type": "object" },
            "columns": { "type": "array" },
            "rows": { "type": "array" },
            "totals": { "type": "array" },
            "taxSummary": { "type": ["object", "null"] },
            "amountInWords": { "type": "string" },
            "homeTotals": { "type": "string" },
            "reverseChargeNote": { "type": "string" },
            "notes": { "type": "array" },
            "payment": { "type": "object" },
            "signature": { "type": "object" },
            "footer": { "type": "object" }
          }
        }
      }
    },
    "documentCase": {
      "type": "object", "required": ["id", "explain", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "explain": { "type": "string" },
        "input": {
          "oneOf": [
            { "type": "object", "required": ["op", "config", "docType", "today", "business"], "additionalProperties": false,
              "description": "spec/documents.md §2: a new draft's defaults.",
              "properties": {
                "op": { "const": "defaults" },
                "config": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*@[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "docType": { "enum": ["invoice", "quote"] },
                "today": { "$ref": "#/$defs/date" },
                "business": {
                  "type": "object", "required": ["countryCode", "homeCurrency", "paymentTermsDays"], "additionalProperties": false,
                  "properties": { "countryCode": { "type": "string" }, "homeCurrency": { "type": "string" },
                    "paymentTermsDays": { "type": "integer", "minimum": 0 }, "lutReference": { "type": "string" } }
                },
                "client": {
                  "type": "object", "required": ["countryCode", "isBusiness"], "additionalProperties": false,
                  "properties": { "countryCode": { "type": "string" }, "isBusiness": { "type": "boolean" },
                    "defaultCurrency": { "type": "string" } }
                }
              } },
            { "type": "object", "required": ["op", "config", "registration", "homeCurrency", "item", "document"], "additionalProperties": false,
              "description": "spec/documents.md §3.1: a catalogue price in the document's currency and price basis.",
              "properties": {
                "op": { "const": "linePrice" },
                "config": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*@[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "registration": { "type": "string" },
                "homeCurrency": { "type": "string" },
                "customRates": { "type": "array" },
                "item": {
                  "type": "object", "required": ["unitPriceMinor", "currency", "priceIncludesTax", "rateId"], "additionalProperties": false,
                  "properties": { "unitPriceMinor": { "$ref": "#/$defs/minor" }, "currency": { "type": "string" },
                    "priceIncludesTax": { "type": "boolean" }, "rateId": { "type": "string" } }
                },
                "document": {
                  "type": "object", "required": ["currency", "pricesIncludeTax"], "additionalProperties": false,
                  "properties": { "currency": { "type": "string" }, "exchangeRate": { "$ref": "#/$defs/decimal" },
                    "pricesIncludeTax": { "type": "boolean" } }
                }
              } }
          ]
        },
        "expected": {
          "oneOf": [
            { "type": "object", "required": ["issueDate", "dueDate", "validUntil", "currency", "supplyType", "roundOff"], "additionalProperties": false,
              "properties": { "issueDate": { "$ref": "#/$defs/date" },
                "dueDate": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                "validUntil": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
                "currency": { "type": "string" }, "supplyType": { "type": "string" },
                "roundOff": { "type": ["boolean", "null"] } } },
            { "type": "object", "required": ["unitPriceMinor"], "additionalProperties": false,
              "properties": { "unitPriceMinor": { "$ref": "#/$defs/minor" } } },
            { "type": "object", "required": ["error"], "additionalProperties": false,
              "properties": { "error": { "enum": ["exchange_rate_missing"] } } }
          ]
        }
      }
    },
    "numberingCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": {
          "type": "object", "required": ["pattern", "reset", "fiscalYearStart", "date", "seq"], "additionalProperties": false,
          "properties": {
            "pattern": { "type": "string" }, "reset": { "enum": ["never", "fiscalYear", "calendarYear"] },
            "fiscalYearStart": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "seq": { "type": "integer", "minimum": 1 },
            "maxLength": { "type": "integer" }, "allowedPattern": { "type": "string" }
          }
        },
        "expected": {
          "oneOf": [
            { "type": "object", "required": ["number", "periodKey"], "additionalProperties": false,
              "properties": { "number": { "type": "string" }, "periodKey": { "type": "string" } } },
            { "type": "object", "required": ["error"], "additionalProperties": false,
              "properties": { "error": { "enum": ["number_too_long", "number_invalid_chars"] } } }
          ]
        }
      }
    },
    "validationCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["config", "format", "value"], "additionalProperties": false,
          "properties": { "config": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*@[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "format": { "type": "string" }, "value": { "type": "string" } } },
        "expected": { "type": "object", "required": ["valid"], "additionalProperties": false,
          "properties": { "valid": { "type": "boolean" }, "normalized": { "type": "string" }, "region": { "type": "string" },
            "error": { "enum": ["format", "checksum", "unknown_region"] } } }
      }
    },
    "wordsCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["minor", "currency"], "additionalProperties": false,
          "properties": { "minor": { "type": "integer", "minimum": 0 }, "currency": { "type": "string" } } },
        "expected": { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "text": { "type": "string" } } }
      }
    },
    "formatCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["op"], "additionalProperties": false,
          "properties": { "op": { "enum": ["money", "percent", "quantity"] }, "minor": { "type": "integer" },
            "currency": { "type": "string" }, "homeCurrency": { "type": "string" }, "value": { "$ref": "#/$defs/decimal" } } },
        "expected": { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "text": { "type": "string" } } }
      }
    },
    "statusCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["docType", "lifecycle", "total", "paid", "today"], "additionalProperties": false,
          "properties": { "docType": { "enum": ["invoice", "quote"] }, "lifecycle": { "enum": ["draft", "issued", "void"] },
            "total": { "type": "integer" }, "paid": { "type": "integer" }, "dueDate": { "$ref": "#/$defs/date" },
            "validUntil": { "$ref": "#/$defs/date" }, "sentAt": { "type": "integer" },
            "outcome": { "enum": ["accepted", "declined", "converted"] }, "today": { "$ref": "#/$defs/date" } } },
        "expected": { "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": { "status": { "enum": ["draft", "issued", "sent", "partiallyPaid", "paid", "overdue", "void",
            "open", "accepted", "declined", "expired", "converted"] }, "outstanding": { "type": "integer" } } }
      }
    },
    "roundingCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["value", "mode"], "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/decimal" }, "mode": { "enum": ["halfAwayFromZero", "halfEven", "towardZero"] } } },
        "expected": { "type": "object", "required": ["result"], "additionalProperties": false, "properties": { "result": { "type": "integer" } } }
      }
    },
    "distributeCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["total"], "additionalProperties": false,
          "properties": { "total": { "type": "integer", "minimum": 0 },
            "exacts": { "type": "array", "items": { "$ref": "#/$defs/decimal" } },
            "weights": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
        "expected": { "type": "object", "required": ["parts"], "additionalProperties": false,
          "properties": { "parts": { "type": "array", "items": { "type": "integer" } } } }
      }
    },
    "upiCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["vpa", "payeeName", "amountMinor", "invoiceNumber"], "additionalProperties": false,
          "properties": { "vpa": { "type": "string" }, "payeeName": { "type": "string" }, "amountMinor": { "type": "integer" },
            "invoiceNumber": { "type": "string" } } },
        "expected": { "type": "object", "required": ["url"], "additionalProperties": false, "properties": { "url": { "type": "string" } } }
      }
    },
    "fieldCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["rule", "value"], "additionalProperties": false,
          "properties": { "rule": { "enum": ["email", "ifsc", "upiVpa", "sortCode", "iban", "bic", "pan", "postalCodeIN",
            "postalCodeGB", "companyNumberGB", "hsnSac"] }, "value": { "type": "string" } } },
        "expected": { "type": "object", "required": ["valid", "normalized"], "additionalProperties": false,
          "properties": { "valid": { "type": "boolean" }, "normalized": { "type": "string" },
            "error": { "enum": ["format", "checksum"] } } }
      }
    },
    "inputCase": {
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": { "type": "object", "required": ["op", "text"], "additionalProperties": false,
          "properties": { "op": { "enum": ["money", "decimal"] }, "text": { "type": "string" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } } },
        "expected": {
          "oneOf": [
            { "type": "object", "required": ["minor"], "additionalProperties": false, "properties": { "minor": { "type": "integer" } } },
            { "type": "object", "required": ["value"], "additionalProperties": false, "properties": { "value": { "$ref": "#/$defs/decimal" } } },
            { "type": "object", "required": ["error"], "additionalProperties": false,
              "properties": { "error": { "enum": ["empty", "invalid", "tooManyDecimals", "tooLarge"] } } }
          ]
        }
      }
    },
    "backupCase": {
      "description": "BackupCodec.validate (spec/backup.md §3). The input file is `base` (a path under spec/) after applying `remove` (JSON Pointers, removed first) and then `set` (JSON Pointer → value), or the literal bytes `raw`. `expected` is either the preview's `live` counts or an error code.",
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": {
          "type": "object", "required": ["appSchemaVersion"], "additionalProperties": false,
          "properties": {
            "appSchemaVersion": { "type": "integer", "minimum": 1 },
            "base": { "type": "string", "pattern": "^samples/.+\\.json$" },
            "raw": { "type": "string" },
            "remove": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
            "set": { "type": "object", "propertyNames": { "pattern": "^/" } }
          }
        },
        "expected": {
          "oneOf": [
            { "type": "object", "required": ["live"], "additionalProperties": false,
              "properties": { "live": { "type": "object", "additionalProperties": false,
          "required": ["businesses", "clients", "catalogItems", "numberingSeries", "documents", "payments", "assets"],
          "properties": {
            "businesses": { "type": "integer" }, "clients": { "type": "integer" }, "catalogItems": { "type": "integer" },
            "numberingSeries": { "type": "integer" }, "documents": { "type": "integer" }, "payments": { "type": "integer" },
            "assets": { "type": "integer" } } } } },
            { "type": "object", "required": ["error"], "additionalProperties": false,
              "properties": { "error": { "enum": ["not_json", "not_a_backup", "newer_format", "newer_schema",
                "invalid_record", "count_mismatch", "duplicate_id", "asset_hash_mismatch", "dangling_reference"] } } }
          ]
        }
      }
    },
    "seriesCase": {
      "description": "Device-owned numbering (spec/sync.md §3–4). op deviceSeries → pattern + label or error; takeOver → counters; duplicates → groups.",
      "type": "object", "required": ["id", "input", "expected"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input": {

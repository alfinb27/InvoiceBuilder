{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoicebuilder.local/spec/schema/currencies.schema.json",
  "title": "Currency reference data (spec/reference/currencies.json)",
  "type": "object",
  "required": [
    "currencies"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "minorUnits",
          "symbol",
          "grouping",
          "wordsMajor",
          "wordsMinor"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "minorUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "grouping": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "wordsMajor": {
            "type": "string",
            "minLength": 1
          },
          "wordsMinor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

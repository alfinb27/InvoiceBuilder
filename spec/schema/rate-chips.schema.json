{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invoicebuilder.local/spec/schema/rate-chips.schema.json",
  "title": "Rate chips of the Add an item sheet (spec/design/rate-chips.json)",
  "type": "object",
  "required": ["version", "maxChips", "families"],
  "additionalProperties": false,
  "properties": {
    "$comment": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "maxChips": { "type": "integer", "minimum": 1, "maximum": 6 },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rates", "hint"],
        "additionalProperties": false,
        "properties": {
          "rates": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "hint": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

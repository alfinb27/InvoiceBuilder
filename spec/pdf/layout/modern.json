{
  "$schema": "../../schema/pdf-layout.schema.json",
  "id": "modern",
  "label": "Modern",
  "description": "An accent band across the top with the title and number reversed out, zebra rows, roomy type.",
  "page": {
    "margins": {
      "top": 0,
      "right": 44,
      "bottom": 36,
      "left": 44
    },
    "footerHeight": 26
  },
  "style": {
    "fontSizes": {
      "title": 22,
      "heading": 10,
      "body": 9.5,
      "small": 8
    },
    "lineHeight": 1.4,
    "colors": {
      "text": "#111827",
      "muted": "#4B5563",
      "rule": "#E2E7EE",
      "onAccent": "#FFFFFF",
      "zebraFill": "#F5F7FA"
    },
    "accentUse": [
      "headerBand",
      "totalRow"
    ],
    "rule": {
      "width": 0.5
    },
    "table": {
      "headerWeight": "semibold",
      "headerUppercase": false,
      "rowPadding": {
        "vertical": 6,
        "horizontal": 7
      },
      "rowRule": "zebra"
    },
    "blockSpacing": 15,
    "logo": {
      "maxWidth": 130,
      "maxHeight": 44
    },
    "qrSize": 88,
    "signatureHeight": 42
  },
  "blocks": [
    {
      "id": "header",
      "variant": "band"
    },
    {
      "id": "parties",
      "variant": "twoColumns"
    },
    {
      "id": "items",
      "variant": "zebra"
    },
    {
      "id": "totals",
      "variant": "right"
    },
    {
      "id": "payment",
      "variant": "twoColumns"
    },
    {
      "id": "notes",
      "variant": "stacked"
    },
    {
      "id": "signature",
      "variant": "right"
    }
  ]
}

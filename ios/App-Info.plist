<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- One window in v1, fully resizable on iPad (ADR-0014). Other keys come from the target's INFOPLIST_KEY_* settings. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- .invoicebackup (spec/backup.md §6): the app exports the type and opens it from Files, Mail and AirDrop. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.invoicebuilder.backup</string>
			<key>UTTypeDescription</key>
			<string>InvoiceBuilder Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>invoicebackup</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.invoicebuilder.backup+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>InvoiceBuilder Backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.invoicebuilder.backup</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Automatic Google Drive backup (spec/backup.md §7.2, ADR-0021): a daily background task that needs the network.
	     The feature itself is on only when GoogleDriveClientID is set (a Google OAuth client for this bundle ID). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.invoicebuilder.drivebackup</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
</dict>
</plist>
